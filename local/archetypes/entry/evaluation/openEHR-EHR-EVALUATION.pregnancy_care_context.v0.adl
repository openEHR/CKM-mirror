	>

definition
	EVALUATION[at0000] matches {    -- Pregnancy precautions
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- Precaution category
						value matches {
							DV_TEXT matches {*}
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0004,    -- Routine
									at0005,    -- Elevated
									at0006,    -- Pregnancy
									at0007,    -- Post-pregnancy
									at0016]    -- Not applicable
								}
							}
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {    -- Applicable from
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {    -- Applicable until
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {    -- Review date
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0013] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- Last updated
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					allow_archetype CLUSTER[at0014] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}


ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Pregnancy precautions">
					description = <"The category of pregnancy-related precautions currently applicable to an individual, to inform their care.">
				>
				["at0001"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Precaution category">
					description = <"The category of pregnancy-related precautions that currently applies to the individual.">
					comment = <"The category may be recorded by a clinician or proposed by a clinical system when a relevant clinical event is documented. ‘Elevated’ may apply, for example, when an individual is sexually active without contraception, planning pregnancy, undergoing fertility treatment, or has a suspected pregnancy pending confirmation. ‘Not applicable’ may apply to individuals who are premenarchal or postmenopausal, or to those unable to carry a pregnancy following surgery, such as hysterectomy.">
				>
				["at0004"] = <
					text = <"Routine">
					description = <"Default category where a pregnancy is considered physiologically possible, an unrecognised pregnancy cannot be excluded without further investigation and no defined value is applicable.">
				>
				["at0005"] = <
					text = <"Elevated">
					description = <"Applies in circumstances when a pregnancy is considered physiologically possible, an unrecognised pregnancy cannot be excluded without further investigation, and there is an increased likelihood of an unrecognised pregnancy.">
				>
				["at0006"] = <
					text = <"Pregnancy">
					description = <"Applies in circumstances when a pregnancy is confirmed.">
				>
				["at0007"] = <
					text = <"Post-pregnancy">
					description = <"Applies when a pregnancy is known to have ended, regardless of gestational age or outcome, and the individual is in the acute recovery period and where a subsequent pregnancy is physiologically unlikely.">
				>
				["at0008"] = <
					text = <"Applicable from">
					description = <"The date and optional time from which the category applies.">
					comment = <"If not recorded, the 'Precaution category' applies from the time of recording. For example: the date of birth for 'Post pregnancy'; the date of a menopause diagnosis for 'Not applicable'; the date of menarche for 'Routine'.">
				>
				["at0009"] = <
					text = <"Applicable until">
					description = <"The date and optional time until which the category is anticipated to apply.">
					comment = <"For example: 28 days after birth for 'Post pregnancy'. The category remains in effect until superseded by a new instance, regardless of this date. This date is informational only and must not be used to end the category automatically; a passed date should prompt review. Leave blank where no end is anticipated.">
				>
				["at0010"] = <
					text = <"Review date">
					description = <"The date when the category should be reassessed.">
					comment = <"Review of the current 'Precaution category' may confirm that the category remains applicable or result in a change to a different category. For example: a scheduled review of an 'Elevated' category following commencement of embryo transfer treatment.">
				>
				["at0012"] = <
					text = <"Comment">
					description = <"Additional narrative about the pregnancy care context not captured in other fields.">
				>
				["at0013"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0014"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0015"] = <
					text = <"Last updated">
					description = <"The date when these pregnancy precautions were last updated.">
				>
				["at0016"] = <
					text = <"Not applicable">
					description = <"Applies when pregnancy is physiologically not possible.">
				>
			>
		>
	>
