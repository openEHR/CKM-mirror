archetype (adl_version=1.4; uid=17c5a32a-e751-4540-853f-db62dbfdc1cd)
	openEHR-EHR-EVALUATION.impairment_summary.v0

concept
	[at0000]	-- Impairment summary
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			author = <
				["name"] = <"Silje Ljosland Bakke, John Tore Valand, Ciprian Gerstenberger, Marte Vassli Gullesen">
				["organisation"] = <"Helse Vest IKT, Helse Nord IKT">
				["email"] = <"silje.ljosland.bakke@helse-vest-ikt.no, john.tore.valand@helse-vest-ikt.no, ciprian-virgil.gerstenberger@hnikt.no, marte.vassli.gullesen@hnikt.no">
			>
		>
	>
description
	original_author = <
		["name"] = <"Heather Leslie">
		["organisation"] = <"Atomica Informatics">
		["email"] = <"heather.leslie@atomicainformatics.com">
		["date"] = <"2026-03-12">
	>
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For å registrere oppsummerende informasjon om én enkelt funksjonsnedsettelse.">
			use = <"Brukes til å registrere oppsummerende informasjon om én enkelt svekkelse i en fysiologisk eller psykologisk funksjon som begrenser individets evne til å utføre en aktivitet uten assistanse. Svekkelsen kan bestå av en mangel, nedsettelse eller en annen funksjonsendring som ligger utenfor normalvariasjonen i befolkningen. Eksempler er nedsatt motorisk kontroll på grunn av redusert muskelstyrke, hypertoni, ataksi eller tremor.

Detaljeringsgraden som benyttes for å identifisere den berørte funksjonen, er et spørsmål om klinisk skjønn. For eksempel kan «kognitiv funksjon» registreres på et overordnet nivå, eller mer spesifikke funksjoner som «korttidshukommelse» og «oppmerksomhetsspenn» kan registreres hver for seg, slik at de kan følges uavhengig av hverandre over tid.

Hver funksjonsnedsettelse kan registreres som en enkelt, vedvarende tilstand som revideres over tid for å dokumentere det kliniske forløpet. Oppdateringer kan baseres på observasjoner som vurderer eller måler funksjonsnedsettelsen, for eksempel motoriske undersøkelser, kognitive screeningtester, depresjonsskalaer eller audiometri. Når funksjonsnedsettelsen ikke lenger er til stede, oppdateres den eksisterende registreringen ved å angi «Alvorlighetsgrad» til «Ingen funksjonsnedsettelse» og registrere «Dato for opphør». Støttetiltak som personlig assistanse, hjelpemidler, miljøtilpasninger eller kompenserende strategier kan forbedre personens funksjonsevne, men påvirker ikke klassifiseringen av selve funksjonsnedsettelsen. Dersom funksjonsnedsettelsen senere gjenoppstår, oppdateres den samme registreringen.

Hos barn kan en funksjon som ligger utenfor det forventede området for alder og utvikling, vurderes av kliniker som en funksjonsnedsettelse.

Det er to andre relaterte arketyper som beskriver ulike sider av individets funksjon i dagliglivet i tillegg til denne:
OBSERVATION.functional_ability, som beskriver individets funksjonsevne ved utførelse av en aktivitet.
EVALUATION.functional_support_requirements, som beskriver hvilken type og grad av hjelp som er nødvendig for at individet skal kunne utføre aktiviteten.

I praksis brukes disse arketypene ofte sammen med andre arketyper, som for eksempel CLUSTER.symptom_sign (Symptom/Sykdomstegn) og EVALUATION.problem_diagnosis (Problem/diagnose).
For eksempel:
- Hos en voksen person med Parkinsons sykdom registreres 'tremor' ved å bruke CLUSTER.symptom_sign (Symptom/Sykdomstegn), 'tilstanden' ved å bruke EVALUATION.problem_diagnosis (Problem/diagnose), 'evnen til å drikke fra en kopp' ved å bruke OBSERVATION.functional_ability, 'motorisk kontroll' ved å bruke EVALUATION.impairment_summary, og 'behovet for en kopp med lokk' ved å bruke EVALUATION.functional_support_requirements.

- Hos en voksen person etter hjerneslag registreres 'venstresidig svakhet' ved å bruke CLUSTER.symptom_sign (Symptom/Sykdomstegn), 'tilstanden' ved å bruke EVALUATION.problem_diagnosis (Problem/diagnose), 'evnen til å forflytte seg fra seng til stol' ved å bruke OBSERVATION.functional_ability, 'motorisk kontroll' i venstre underekstremitet ved å bruke EVALUATION.impairment_summary, og 'behovet for fysisk assistanse fra to personer ved forflytning fra seng til stol' ved å bruke EVALUATION.functional_support_requirements.

- Hos en voksen person med Alzheimers sykdom registreres 'glemsomhet' ved å bruke CLUSTER.symptom_sign (Symptom/Sykdomstegn), 'tilstanden' ved å bruke EVALUATION.problem_diagnosis (Problem/diagnose), 'evnen til å håndtere legemidler' ved å bruke OBSERVATION.functional_ability, 'korttidshukommelse' ved å bruke EVALUATION.impairment_summary, og 'behovet for påminnelser fra en omsorgsperson' ved å bruke EVALUATION.functional_support_requirements.

- Hos et barn med kronisk mellomørebetennelse registreres 'øresekresjon' ved å bruke CLUSTER.symptom_sign (Symptom/Sykdomstegn), 'tilstanden' ved å bruke EVALUATION.problem_diagnosis (Problem/diagnose), 'evnen til å følge instruksjoner i klasserommet' ved å bruke OBSERVATION.functional_ability, 'hørsel' ved å bruke EVALUATION.impairment_summary, og 'behovet for sitteplass nær læreren' ved å bruke EVALUATION.functional_support_requirements.">
			misuse = <"Brukes ikke for å registrere en persons evne til å utføre en aktivitet. For dette formålet benyttes arketypen OBSERVATION.functional_ability.

Brukes ikke for å registrere utviklingsmilepæler. For dette formålet benyttes arketypen OBSERVATION.developmental_milestone.

Brukes ikke for å registrere en vurdering av omfanget av støtte som kreves for å optimalisere en persons evne til å utføre en aktivitet som følge av en funksjonsnedsettelse. For dette formålet benyttes arketypen EVALUATION.functional_support_requirements.

Brukes ikke for å registrere den underliggende diagnosen, sykdommen, skaden, den medfødte tilstanden eller annen helsetilstand som er assosiert med funksjonsnedsettelsen. For dette formålet benyttes arketypen EVALUATION.problem_diagnosis (Problem/diagnose).

Brukes ikke for å registrere informasjon om et symptom eller klinisk tegn. For dette formålet benyttes arketypen CLUSTER.symptom_sign (Symptom/Sykdomstegn).

Brukes ikke for å registrere vurdering eller måling av en funksjonsnedsettelse på et gitt tidspunkt. For dette formålet benyttes den relevante OBSERVATION-arketype.

Brukes ikke for å registrere en forbigående funksjonsendring, som akutt ruspåvirkning eller sedasjon. For dette formålet benyttes den relevante OBSERVATION-arketype.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record summary information about a single impairment.">
			use = <"Use to record summary information about a single impairment of a physiological or psychological function that limits an individual's ability to perform an activity unaided. An impairment may be a deficit, excess or other alteration of a function that is outside the range found in the general population. For example, motor control may be impaired by loss of muscle power, hypertonicity, ataxia or tremor.

The level of detail used to identify the affected function is a matter of clinical judgement. For example, \"Cognitive function\" may be recorded generally, or \"Short-term memory\" and \"Attention span\" separately, so that each can be followed independently over time.

Each impairment can be recorded as a single, persistent instance, updated over time to document its clinical course. Revisions may be informed by observations that assess or measure the impairment, such as motor assessments, cognitive screening scores, depression rating scales or audiometry. When the impairment resolves, the existing instance is revised by recording 'Severity' as 'No impairment' and adding the 'Date of resolution'. Supports, such as human assistance, assistive devices, environmental modifications or compensatory strategies, may improve functional ability, but do not change or resolve the impairment. If the impairment recurs, the same instance is revised.

In children, a clinician may identify a function that is outside the age-appropriate range as an impairment.

This archetype is one of a set of three related archetypes designed to represent different aspects of how an individual functions in everyday life:
- OBSERVATION.functional_ability, which records what an individual can do when performing an activity;
- EVALUATION.impairment_summary, which records an impairment that may limit what an individual can do; and
- EVALUATION.functional_support_requirements, which records the type and level of support an individual needs for an activity.

In practice, these archetypes are often used alongside others, such as CLUSTER.symptom_sign and EVALUATION.problem_diagnosis. For example:
- For an adult with Parkinson’s disease, tremor is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to drink from a cup using OBSERVATION.functional_ability, motor control using EVALUATION.impairment_summary, and the need for a cup with a lid using EVALUATION.functional_support_requirements.
- For an adult after a stroke, left-sided weakness is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to transfer from bed to chair using OBSERVATION.functional_ability, left lower limb motor control using EVALUATION.impairment_summary, and the need for physical assistance from two people to transfer from bed to chair using EVALUATION.functional_support_requirements.
- For an adult with Alzheimer’s disease, forgetfulness is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to manage medications using OBSERVATION.functional_ability, short-term memory using EVALUATION.impairment_summary, and the need for prompting from a carer using EVALUATION.functional_support_requirements.
- For a child with chronic otitis media, ear discharge is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to follow instructions in the classroom using OBSERVATION.functional_ability, hearing using EVALUATION.impairment_summary, and the need for seating near the teacher using EVALUATION.functional_support_requirements.">
			misuse = <"Not to be used to record an individual's ability to perform an activity. Use the OBSERVATION.functional_ability archetype for this purpose.

Not to be used to record developmental milestones. Use the OBSERVATION.developmental_milestone archetype for this purpose.

Not to be used to record an assessment of the range of supports required to optimise an individual's ability to perform an activity as a result of an impairment. Use the EVALUATION.functional_support_requirements archetype for this purpose.

Not to be used to record the underlying diagnosis, disease, injury, congenital condition, or other health condition associated with the impairment. Use the EVALUATION.problem_diagnosis archetype for this purpose.

Not to be used to record information about a symptom. Use the CLUSTER.symptom_sign archetype for this purpose.

Not to be used to record the assessment or measurement of an impairment at a point in time. Use the relevant OBSERVATION archetype for this purpose.

Not to be used to record a transient alteration of function, such as acute intoxication or sedation. Use the relevant OBSERVATION archetype for this purpose.">
			copyright = <"© openEHR Foundation">
		>
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Vebjørn Arntzen, Oslo University Hospital, Norway", "Sparked AU, CSIRO, Australia (openEHR Editor)", "SB Bhattacharyya, Bhattacharyyas Clinical Records Research & Informatics LLP, India", "Tara Bonet Chinillach, Catalan Health Service, Spain", "kim Drever, Kudos Paediatrics, Australia", "William Goossen, Results 4 Care, Netherlands", "Joost Holslag, Joost Holslag Geneeskunde & Advies, Netherlands", "Patricia Homem-Silva, University of Porto, Portugal", "Evelyn Hovenga, EJSH Consulting, Australia", "Heather Leslie, Atomica Informatics, Australia (openEHR Editor)", "Michael Lutz, BITsoft, Germany", "Olha Nikolaieva, University Hospital Basel, Switzerland", "Mikael Nyström, Cambio Healthcare Systems AB, Sweden", "Vuk Radnić, Better, Slovenia", "Norwegian Review Summary, Norwegian Public Hospitals, Norway", "Averil Tam, CSIRO, Australia", "Nyree Taylor, CSIRO, Australia (openEHR Editor)">
	other_details = <
