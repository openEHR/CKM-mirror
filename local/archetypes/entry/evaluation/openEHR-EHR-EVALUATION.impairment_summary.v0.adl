	>

definition
	EVALUATION[at0000] matches {    -- Impairment summary
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- Impairment name
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0018] occurrences matches {0..1} matches {    -- Clinical description
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- Severity
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0004,    -- No impairment
									at0005,    -- Mild impairment
									at0006,    -- Moderate impairment
									at0007,    -- Severe impairment
									at0008]    -- Complete impairment
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {    -- Impact
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {    -- Trajectory
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0011,    -- Stable
									at0012,    -- Improving
									at0013,    -- Worsening
									at0014,    -- Fluctuating
									at0015]    -- Unknown
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0016] occurrences matches {0..1} matches {    -- Date of onset
						value matches {
							DV_DATE matches {*}
						}
					}
					ELEMENT[at0017] occurrences matches {0..1} matches {    -- Date of resolution
						value matches {
							DV_DATE matches {*}
						}
					}
					allow_archetype CLUSTER[at0019] occurrences matches {0..*} matches {    -- Additional details
						include
							archetype_id/value matches {/.*/}
					}
					ELEMENT[at0020] occurrences matches {0..1} matches {    -- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0021] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0023] occurrences matches {0..1} matches {    -- Last updated
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					allow_archetype CLUSTER[at0022] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}


ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Impairment summary">
					description = <"Summary information about loss, limitation, deficit, or alteration of a body function or body structure.">
				>
				["at0001"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Impairment name">
					description = <"The name of the impairment.">
					comment = <"For example: memory impairment; or deformity of the right foot.">
				>
				["at0003"] = <
					text = <"Severity">
					description = <"The extent or magnitude of the impairment.">
					comment = <"The value set is aligned with the ICF 'Extent or magnitude of impairment' qualifier scale. The value 'No impairment' may be recorded when a previously identified impairment has resolved.">
				>
				["at0004"] = <
					text = <"No impairment">
					description = <"None, absent, or negligible (0–4%).">
				>
				["at0005"] = <
					text = <"Mild impairment">
					description = <"Slight or low (5–24%).">
				>
				["at0006"] = <
					text = <"Moderate impairment">
					description = <"Medium or fair (25–49%).">
				>
				["at0007"] = <
					text = <"Severe impairment">
					description = <"High or extreme (50–95%).">
				>
				["at0008"] = <
					text = <"Complete impairment">
					description = <"Total (96–100%).">
				>
				["at0009"] = <
					text = <"Impact">
					description = <"Narrative description of the impact of the impairment on the individual, including effects on body functions, activities, participation, or wellbeing.">
					comment = <"For example: Difficulty remembering recent conversations, instructions, or appointments without reminders; or altered gait, unsteadiness and difficulty walking long distances.">
				>
				["at0010"] = <
					text = <"Trajectory">
					description = <"The overall trend in the severity and impact of the impairment over time.">
				>
				["at0011"] = <
					text = <"Stable">
					description = <"The overall trend in the severity or impact of the impairment over time is unchanged; no improvement or worsening noted over time.">
				>
				["at0012"] = <
					text = <"Improving">
					description = <"The severity or impact of the impairment is decreasing over time.">
				>
				["at0013"] = <
					text = <"Worsening">
					description = <"The severity or impact of the impairment is increasing over time.">
				>
				["at0014"] = <
					text = <"Fluctuating">
					description = <"The severity or impact of the impairment varies over time, with periods of improvement and worsening.">
				>
				["at0015"] = <
					text = <"Unknown">
					description = <"The overall trend in the severity or impact of the impairment over time cannot be determined.">
				>
				["at0016"] = <
					text = <"Date of onset">
					description = <"The date on which the impairment was first identified.">
					comment = <"Partial dates are permitted.">
				>
				["at0017"] = <
					text = <"Date of resolution">
					description = <"The date on which the impairment resolved.">
					comment = <"Partial dates are permitted.">
				>
				["at0018"] = <
					text = <"Clinical description">
					description = <"Narrative description of the impairment, including relevant clinical characteristics.">
					comment = <"For example: Impairment of short-term memory affecting the ability to retain and recall recently acquired information; or structural deformity of the foot affecting normal alignment and weight distribution.">
				>
				["at0019"] = <
					text = <"Additional details">
					description = <"Additional structured details about the specified impairment.">
				>
				["at0020"] = <
					text = <"Comment">
					description = <"Additional narrative about the impairment not captured in other fields.">
				>
				["at0021"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0022"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0023"] = <
					text = <"Last updated">
					description = <"The date when this impairment summary was last updated.">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Sammendrag av funksjonsnedsettelse">
					description = <"Sammendragsinformasjon om tap, begrensning, mangel eller endring av en kroppsfunksjon eller kroppsstruktur.">
				>
				["at0001"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Navn på funksjonsnedsettelse">
					description = <"Navnet på funksjonsnedsettelsen.">
					comment = <"For eksempel: hukommelsessvikt eller deformitet av høyre fot.">
				>
				["at0003"] = <
					text = <"Alvorlighetsgrad">
					description = <"Omfanget eller graden av funksjonsnedsettelsen.">
					comment = <"Verdisettet er i samsvar med ICF-kvalifikatorskalaen \"Extent or magnitude of impairment\". Verdien \"Ingen funksjonsnedsettelse\" kan registreres dersom en tidligere identifisert funksjonsnedsettelse er opphørt.">
				>
				["at0004"] = <
					text = <"Ingen funksjonsnedsettelse">
					description = <"Ingen, fraværende eller ubetydelig (0-4 %).">
				>
				["at0005"] = <
					text = <"Lett funksjonsnedsettelse">
					description = <"Lett eller lav (5-24 %).">
				>
				["at0006"] = <
					text = <"Moderat funksjonsnedsettelse">
					description = <"Middels eller noe (25-49 %).">
				>
				["at0007"] = <
					text = <"Alvorlig funksjonsnedsettelse">
					description = <"Høy eller ekstrem (50-95 %).">
				>
				["at0008"] = <
					text = <"Fullstendig funksjonsnedsettelse">
					description = <"Totalt (96-100 %).">
				>
				["at0009"] = <
					text = <"Innvirkning">
					description = <"Fritekstbeskrivelse av funksjonsnedsettelsens innvirkning på individet, inkludert effekter på kroppsfunksjoner, aktiviteter, deltakelse eller velvære.">
					comment = <"For eksempel: vansker med å huske nylige samtaler, instruksjoner eller avtaler uten påminnelser; eller endret gangmønster, ustøhet og vansker med å gå lange strekninger.">
				>
				["at0010"] = <
					text = <"Forløp">
					description = <"Den generelle utviklingen i funksjonsnedsettelsens alvorlighetsgrad og innvirkning over tid.">
				>
				["at0011"] = <
					text = <"Stabil">
					description = <"Den generelle utviklingen i funksjonsnedsettelsens alvorlighetsgrad eller innvirkning er uendret over tid; ingen forbedring eller forverring observert over tid.">
				>
				["at0012"] = <
					text = <"Bedres">
					description = <"Funksjonsnedsettelsens alvorlighetsgrad eller innvirkning avtar over tid.">
				>
				["at0013"] = <
					text = <"Forverres">
					description = <"Funksjonsnedsettelsens alvorlighetsgrad eller innvirkning øker over tid.">
				>
				["at0014"] = <
					text = <"Fluktuerende">
					description = <"Funksjonsnedsettelsens alvorlighetsgrad eller innvirkning varierer over tid, med perioder med forbedring og forverring.">
				>
				["at0015"] = <
					text = <"Ukjent">
					description = <"Den generelle utviklingen i funksjonsnedsettelsens alvorlighetsgrad eller innvirkning over tid kan ikke fastslås.">
				>
				["at0016"] = <
					text = <"Debutdato">
					description = <"Datoen da funksjonsnedsettelsen først ble identifisert.">
					comment = <"Delvise datoer er tillatt.">
				>
				["at0017"] = <
					text = <"Opphørsdato">
					description = <"Datoen da funksjonsnedsettelsen opphørte.">
					comment = <"Delvise datoer er tillatt.">
				>
				["at0018"] = <
					text = <"Klinisk beskrivelse">
					description = <"Fritekstbeskrivelse av funksjonsnedsettelsen, inkludert relevante kliniske kjennetegn.">
					comment = <"For eksempel: nedsatt korttidshukommelse som påvirker evnen til å huske og gjenkalle nylig tilegnet informasjon; eller strukturell deformitet av foten som påvirker normal stillingsplassering og vektfordeling.">
				>
				["at0019"] = <
					text = <"Ytterligere detaljer">
					description = <"Ytterligere strukturerte detaljer om den spesifiserte funksjonsnedsettelsen.">
				>
				["at0020"] = <
					text = <"Kommentar">
					description = <"Ytterligere fritekst om funksjonsnedsettelsen som ikke er fanget opp i andre felt.">
				>
				["at0021"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0022"] = <
					text = <"Tilleggsinformasjon">
					description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller eller formalismer.">
					comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.">
				>
				["at0023"] = <
					text = <"Sist oppdatert">
					description = <"Datoen da dette sammendraget av funksjonsnedsettelsen sist ble oppdatert.">
				>
			>
		>
	>
